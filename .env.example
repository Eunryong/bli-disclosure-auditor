# ==============================================================================
# Disclosure vs. Smart Contract Mismatch Auditor - Environment Variables Example
# Copy this file to `.env` before running locally (`cp .env.example .env`)
# ==============================================================================

# 1. SQLite Database (Prisma)
DATABASE_URL="file:./dev.db"

# 2. Optional OpenAI API Key for LLM-assisted Whitepaper 5-Claim Extraction
# (Falls back to deterministic regex/section parser when left empty)
OPENAI_API_KEY=""

# 3. Local / Custom RPC Configuration (Optional)
# Leave empty to use the built-in local EVM execution engine (`@ethereumjs/vm`)
RPC_URL=""
DEPLOYER_PRIVATE_KEY=""

# 4. Ethereum Sepolia Testnet Configuration (Chain ID: 11155111)
# Run `npm run wallet:setup` to auto-generate a dedicated ephemeral deployer wallet
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
SEPOLIA_DEPLOYER_PRIVATE_KEY=""
SEPOLIA_DEPLOYER_ADDRESS=""

# 5. Deployed Contract Addresses (Auto-populated by `npm run contracts:deploy` or `npm run contracts:deploy:sepolia`)
NEXT_PUBLIC_CHAIN_ID="11155111"
NEXT_PUBLIC_COMPLIANT_TOKEN_ADDRESS="0x8efaf393b6b3cd72e7dde7f2e3b6e371f322fb66"
NEXT_PUBLIC_MISMATCHED_TOKEN_ADDRESS="0x37f9bd8d311bf1f2c90039f9a75f7822f4fefb90"
NEXT_PUBLIC_AUDIT_REGISTRY_ADDRESS="0xb3bc13a867b3aa3cdadab22ea12fd82f7bd69054"
