# ==============================================================================
# Disclosure vs. Smart Contract Mismatch Auditor - Environment Variables Example
# Copy this file to `.env` before running locally (`cp .env.example .env`)
# ==============================================================================

# 1. SQLite Database (Prisma)
DATABASE_URL="file:./dev.db"

# 2. Google Gemini API Configuration (Used in Step 1 Extract, Step 2 CRE Compare, Step 3 Legal Review)
# Get an API key from https://aistudio.google.com/app/apikey or configure directly in the Web UI Header
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Optional Legacy OpenAI API Key
OPENAI_API_KEY=""

# 3. Local / Custom RPC Configuration (Optional)
# Leave empty to use the built-in local EVM execution engine (`@ethereumjs/vm`)
RPC_URL=""
DEPLOYER_PRIVATE_KEY=""

# 4. Ethereum Sepolia Testnet Configuration (Chain ID: 11155111)
# Run `npm run wallet:setup` to auto-generate a dedicated ephemeral deployer wallet
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
SEPOLIA_DEPLOYER_PRIVATE_KEY=""
SEPOLIA_DEPLOYER_ADDRESS=""

# 5. Deployed Contract Addresses (Ethereum Sepolia Testnet - Chain ID: 11155111)
NEXT_PUBLIC_CHAIN_ID="11155111"
NEXT_PUBLIC_COMPLIANT_TOKEN_ADDRESS="0x534c51921913a8717Ca2db550b77fFabf168f71e"
NEXT_PUBLIC_MISMATCHED_TOKEN_ADDRESS="0xbbE3c849D90c63645F917Be84a5b454FE858186F"
NEXT_PUBLIC_AUDIT_REGISTRY_ADDRESS="0x5B0547C68bc608E6A9b94C515B5B66215981856c"
